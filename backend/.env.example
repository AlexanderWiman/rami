# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rami_forum

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Initial superadmin (used on first run)
INITIAL_SUPERADMIN_USERNAME=admin
INITIAL_SUPERADMIN_PASSWORD=change-this-password

# IslamicAPI (optional, for Asma ul Husna voice variants - get free key at islamicapi.com)
# ISLAMIC_API_KEY=your-api-key

# Server
PORT=3000
NODE_ENV=development
